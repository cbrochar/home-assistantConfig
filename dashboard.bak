custom_header:
  active_tab_color: var(--state-icon-active-color)
  background: var(--app-header-background-color)
  compact_mode: true
  elements_color: var(--app-header-text-color)
  exceptions:
    - conditions:
        user: Logan
      config:
        default_tab: logan
        hide_config: true
        hide_help: true
        hide_raw: true
        hide_tabs: logan
        hide_unused: true
        menu_hide: true
  menu_dropdown: true
  tab_indicator_color: var(--state-icon-active-color)
title: Mi Casa
views:
  - icon: 'mdi:home'
    panel: false
    path: default_view
    theme: Google Dark Theme
    title: Home
    visible:
      - user: 4f6f33d1508c4c6893885f0fb1e200d9
    badges:
      - entity: person.chad
      - entity: person.logan
      - entity: person.nathaly
      - entity: sensor.kitchen_temperature
    cards:
      - entity: weather.ecobee
        type: weather-forecast
      - type: 'custom:search-card'
        max_results: 10
      - columns: 3
        entities:
          - entity: light.bedroom_lights
          - entity: light.ridge
          - entity: light.colored_lights
          - entity: light.foyer_overhead
          - entity: light.living_room_lamp
          - entity: light.turkish_lamp
        title: Lights
        type: glance
      - type: alarm-panel
        states:
          - arm_home
          - arm_away
        entity: alarm_control_panel.alarm
        name: Home Alarm
        theme: Dark Turqoise
      - card:
          title: Lights On
          type: glance
        columns: 3
        entities:
          - entity: light.living_room_lamp
            tap_action:
              action: toggle
          - entity: light.turkish_lamp
            tap_action:
              action: toggle
          - entity: light.kitchen_recessed
            tap_action:
              action: toggle
          - entity: light.kitchen_recessed_2
            tap_action:
              action: toggle
          - entity: light.kitchen_table
            tap_action:
              action: toggle
          - entity: light.front_entry
            tap_action:
              action: toggle
          - entity: light.foyer_recessed
            tap_action:
              action: toggle
          - entity: light.foyer_overhead
            tap_action:
              action: toggle
          - entity: light.dining
            tap_action:
              action: toggle
        state_filter:
          - 'on'
        type: entity-filter
      - artwork: cover
        entity: media_player.everywhere
        hide_power: true
        tts:
          entity_id:
            - group.house_alexa
          platform: alexa
        type: 'custom:mini-media-player'
      - entity: climate.ecobee
        type: thermostat
      - artwork: cover
        entity: media_player.nathaly_vasquez_ruizs_library
        hide_power: true
        type: 'custom:mini-media-player'
      - entities:
          - entity: input_boolean.notify_home
        show_header_toggle: false
        title: Home/Away
        type: entities
      - ip: 192.168.0.39/
        title: Ridge
        topic: wled/3d3345
        type: 'custom:wled-control-card'
      - card:
          title: Televisions On
          type: glance
        columns: 3
        entities:
          - entity: binary_sensor.daneila_tv_on
            tap_action:
              action: toggle
          - entity: binary_sensor.bedroom_tv_on
            tap_action:
              action: toggle
          - entity: media_player.main_tv
            tap_action:
              action: toggle
          - entity: binary_sensor.projector_on
            tap_action:
              action: toggle
        state_filter:
          - 'on'
        type: entity-filter
      - artwork: cover
        entity: media_player.kitchen_echo
        hide_power: true
        tts:
          entity_id: media_player.kitchen_echo
          platform: alexa
        type: 'custom:mini-media-player'
      - type: entities
        entities:
          - binary_sensor.front_door_ding
          - sensor.front_door_last_activity
          - sensor.front_door_last_ding
          - sensor.front_door_last_motion
          - binary_sensor.front_door_motion_2
          - sensor.front_door_volume
      - type: picture-entity
        entity: camera.front_door
      - type: entities
        entities:
          - vacuum.rosie
      - type: entities
        entities:
          - vacuum.wall_e
      - type: media-control
        entity: media_player.itunes
      - type: entities
        entities:
          - binary_sensor.bedroom_windows
          - binary_sensor.front_and_garage_door
          - binary_sensor.great_room_windows
          - binary_sensor.kitchen_motion
          - binary_sensor.kitchen_windows
          - binary_sensor.living_dining_rm_windows
      - type: entity
        entity: light.front_entry
      - type: entities
        entities:
          - cover.garage_door
      - type: entities
        entities:
          - lock.yale_door_lock_2
  - icon: 'mdi:television'
    path: living-room
    theme: Google Dark Theme
    title: Living Room
    visible:
      - user: 4f6f33d1508c4c6893885f0fb1e200d9
