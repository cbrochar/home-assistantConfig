            icon: 'mdi:reload'
            icon_height: 75px
            name: Restart HA
            tap_action:
              action: call-service
              service: homeassistant.check_config
            type: button
          - hold_action:
              action: none
            icon: 'mdi:head-sync-outline'
            icon_height: 75px
            name: Reload AutoM
            tap_action:
              action: call-service
              service: automation.reload
            type: button
        type: horizontal-stack
